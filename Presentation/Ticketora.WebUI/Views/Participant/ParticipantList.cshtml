@model List<Ticketora.Application.Features.MediatorDesignPattern.Participants.Results.GetParticipantsQueryResult>

@{
    ViewData["Title"] = "Katılımcılar";
}

<div class="section-head">
    <div>
        <div class="eyebrow">Katılımcılar</div>
        <h1>Katılımcı Listesi</h1>
        <p>Etkinlik katılımcılarını görüntüle ve yönet.</p>
    </div>
    <a href="/Participant/CreateParticipant" class="btn btn-primary">Yeni Katılımcı</a>
</div>

<div class="surface p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Ad</th>
                    <th>Soyad</th>
                    <th>E-posta</th>
                    <th>Telefon</th>
                    <th>Check-in</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var participant in Model)
                {
                    <tr>
                        <td><strong>@participant.Name</strong></td>
                        <td>@participant.Surname</td>
                        <td>@participant.Email</td>
                        <td>@participant.PhoneNumber</td>
                        <td>@participant.CheckInDate</td>
                        <td class="text-end">
                            <a href="/Participant/UpdateParticipant/@participant.ParticipantId" class="btn btn-sm btn-outline-primary">Güncelle</a>
                            <a href="/Participant/DeleteParticipant/@participant.ParticipantId" class="btn btn-sm btn-outline-danger">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
