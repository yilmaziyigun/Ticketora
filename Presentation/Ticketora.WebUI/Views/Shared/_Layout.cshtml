<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Ticketora</title>

    <meta name="description"
          content="Konser, tiyatro, stand-up, sinema ve festival etkinliklerini Ticketora ile keşfet." />

    <meta name="theme-color" content="#0d1020" />

    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Ticketora.WebUI.styles.css"
          asp-append-version="true" />
</head>

<body>

    <div class="app-shell">

        <header class="app-header">

            <nav class="navbar navbar-expand-lg app-nav">

                <div class="container-fluid ticketora-container px-3 px-lg-4">

                    <a class="navbar-brand ticketora-brand"
                       asp-controller="Home"
                       asp-action="Index">

                        <span class="brand-mark">T</span>

                        <span class="brand-text">
                            <strong>Ticketora</strong>
                            <small>Etkinliğin burada</small>
                        </span>

                    </a>

                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#mainNav"
                            aria-controls="mainNav"
                            aria-expanded="false"
                            aria-label="Menüyü aç">

                        <span class="navbar-toggler-icon"></span>

                    </button>

                    <div class="collapse navbar-collapse" id="mainNav">

                        <ul class="navbar-nav ms-lg-5 me-auto">

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="Index">
                                    Ana Sayfa
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Event"
                                   asp-action="EventList">
                                    Etkinlikler
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Category"
                                   asp-action="CategoryList">
                                    Kategoriler
                                </a>
                            </li>

                        </ul>

                        <ul class="navbar-nav align-items-lg-center gap-lg-2">

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                @if (User.IsInRole(Ticketora.WebUI.Constants.AppRoles.Admin))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link"
                                           asp-controller="Admin"
                                           asp-action="Index">
                                            Admin
                                        </a>
                                    </li>
                                }

                                <li class="nav-item">
                                    <a class="nav-panel-button"
                                       asp-controller="UserPanel"
                                       asp-action="Index">
                                        Panelim
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-logout-button"
                                       asp-controller="Account"
                                       asp-action="Logout">
                                        Çıkış
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-login-link"
                                       asp-controller="Account"
                                       asp-action="Login">
                                        Giriş Yap
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-register-button"
                                       asp-controller="Account"
                                       asp-action="Register">
                                        Kayıt Ol

                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             width="17"
                                             height="17"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2.2"
                                             stroke-linecap="round"
                                             stroke-linejoin="round">

                                            <path d="M5 12h14"></path>
                                            <path d="m13 6 6 6-6 6"></path>

                                        </svg>
                                    </a>
                                </li>
                            }

                        </ul>

                    </div>

                </div>

            </nav>

        </header>

        <main class="page-wrap" role="main">
            @RenderBody()
        </main>

        <footer class="app-footer">

            <div class="container-fluid ticketora-container px-3 px-lg-4">

                <div class="row g-4 footer-main">

                    <div class="col-lg-5">

                        <a class="footer-brand"
                           asp-controller="Home"
                           asp-action="Index">

                            <span class="brand-mark">T</span>

                            <span class="brand-text">
                                <strong>Ticketora</strong>
                                <small>Etkinliğin burada</small>
                            </span>

                        </a>

                        <p class="footer-description">
                            Konser, tiyatro, stand-up, sinema, festival ve özel
                            gösterileri keşfet. Biletini güvenle satın al ve
                            dijital olarak yanında taşı.
                        </p>

                        <div class="footer-features">

                            <span>
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="17"
                                     height="17"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">

                                    <path d="M20 13c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V5l8-3 8 3Z"></path>
                                    <path d="m9 12 2 2 4-4"></path>

                                </svg>

                                Güvenli ödeme
                            </span>

                            <span>
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="17"
                                     height="17"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">

                                    <rect width="18"
                                          height="14"
                                          x="3"
                                          y="5"
                                          rx="2"></rect>

                                    <path d="M7 15h.01"></path>
                                    <path d="M11 15h2"></path>

                                </svg>

                                Dijital bilet
                            </span>

                        </div>

                    </div>

                    <div class="col-6 col-md-4 col-lg-2">

                        <h5 class="footer-title">Platform</h5>

                        <ul class="footer-links">

                            <li>
                                <a asp-controller="Home"
                                   asp-action="Index">
                                    Ana Sayfa
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Event"
                                   asp-action="EventList">
                                    Etkinlikler
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Category"
                                   asp-action="CategoryList">
                                    Kategoriler
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Account"
                                   asp-action="Register">
                                    Ücretsiz Üye Ol
                                </a>
                            </li>

                        </ul>

                    </div>

                    <div class="col-6 col-md-4 col-lg-2">

                        <h5 class="footer-title">Etkinlikler</h5>

                        <ul class="footer-links">

                            <li>
                                <a asp-controller="Event"
                                   asp-action="EventList">
                                    Konser
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Event"
                                   asp-action="EventList">
                                    Tiyatro
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Event"
                                   asp-action="EventList">
                                    Stand-Up
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Event"
                                   asp-action="EventList">
                                    Festival
                                </a>
                            </li>

                        </ul>

                    </div>

                    <div class="col-md-4 col-lg-3">

                        <div class="footer-card">

                            <small>Yeni etkinlikleri keşfet</small>

                            <h5>
                                Şehrindeki unutulmaz deneyimlere yerini ayır.
                            </h5>

                            <a class="footer-button"
                               asp-controller="Event"
                               asp-action="EventList">

                                Etkinlikleri Gör

                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="17"
                                     height="17"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2.2"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <path d="M5 12h14"></path>
                                    <path d="m13 6 6 6-6 6"></path>

                                </svg>

                            </a>

                        </div>

                    </div>

                </div>

                <div class="footer-bottom">

                    <span>
                        &copy; 2026 Ticketora. Tüm hakları saklıdır.
                    </span>

                    <span>
                        Dijital bilet ve etkinlik rezervasyon platformu
                    </span>

                </div>

            </div>

        </footer>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
