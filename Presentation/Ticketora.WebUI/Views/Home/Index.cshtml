            </div>

            <div class="stat-card">
                <small>Aktif şehir</small>
                <strong>@cityCount</strong>
                <span>Türkiye'nin farklı noktalarında.</span>
            </div>

            <div class="stat-card">
                <small>Konser</small>
                <strong>@concertEvents</strong>
                <span>Canlı müzik ve festival programı.</span>
            </div>

            <div class="stat-card">
                <small>Sinema</small>
                <strong>@cinemaEvents</strong>
                <span>Özel gösterim ve film etkinliği.</span>
            </div>

        </section>
    </div>

