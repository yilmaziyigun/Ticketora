@model List<Ticketora.Application.Features.CQRSDesignPattern.Categories.Results.GetCategoryQueryResult>

@{
    ViewData["Title"] = "Kategoriler";
}

<div class="section-head">
    <div>
        <div class="eyebrow">Kategoriler</div>
        <h1>İlgi alanına göre keşfet</h1>
        <p>Etkinlikleri kategoriye göre filtreleyerek daha hızlı bul.</p>
    </div>
</div>

<div class="category-grid">
    @foreach (var category in Model)
    {
        <a class="category-tile" href="/Event/EventList?categoryId=@category.CategoryId">
            <span>@category.CategoryName</span>
            <strong>Etkinlikleri Gör</strong>
        </a>
    }
</div>
