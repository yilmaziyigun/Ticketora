@model Ticketora.WebUI.Models.RegisterViewModel

@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="auth-shell wide">
    <div class="surface p-4 p-md-5">
        <div class="eyebrow mb-2">Yeni Hesap</div>
        <h1 class="h3 mb-2">Kayıt Ol</h1>
        <p class="text-muted mb-4">Rezervasyon yapmak ve biletlerini saklamak için profilini oluştur.</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">Ad</label>
                    <input asp-for="Name" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Surname" class="form-label">Soyad</label>
                    <input asp-for="Surname" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">E-posta</label>
                    <input asp-for="Email" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label">Telefon</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label">Parola</label>
                    <input asp-for="Password" type="password" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label">Parola Tekrar</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" />
                </div>
            </div>

            <button class="btn btn-primary w-100 mt-4">Kayıt Ol</button>
            <a href="/Account/Login" class="btn btn-link w-100 mt-2">Zaten hesabım var</a>
        </form>
    </div>
</div>
