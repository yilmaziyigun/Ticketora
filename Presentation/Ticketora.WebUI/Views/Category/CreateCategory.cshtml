@model Ticketora.Application.Features.CQRSDesignPattern.Categories.Commands.CreateCategoryCommand

@{
    ViewData["Title"] = "Yeni Kategori";
}

<div class="auth-shell">
    <div class="surface p-4 p-md-5">
        <div class="eyebrow mb-2">Kategori</div>
        <h1 class="h3 mb-4">Yeni Kategori</h1>

        <form method="post">
            <div class="mb-3">
                <label asp-for="Categoryname" class="form-label">Kategori Adı</label>
                <input asp-for="Categoryname" class="form-control" />
            </div>

            <div class="d-grid d-sm-flex gap-2">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a href="/Category/CategoryList" class="btn btn-outline-secondary">Kategorilere Dön</a>
            </div>
        </form>
    </div>
</div>
