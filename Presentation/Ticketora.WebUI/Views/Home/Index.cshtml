<div class="ticketora-home">

    <!-- HERO -->
    <section class="ticketora-hero">
        <div class="container ticketora-hero-content">

            <div>
                <div class="hero-eyebrow">
                    <span class="hero-eyebrow-dot"></span>
                    Şehrin ritmini yakala
                </div>

                <h1 class="hero-title">
                    Unutulmaz anlara
                    <span>biletin hazır.</span>
                </h1>

                <p class="hero-description">
                    Konserlerden tiyatro oyunlarına, stand-up gösterilerinden özel talk show
                    programlarına kadar şehrin en sevilen etkinliklerini keşfet.
                    Biletini güvenle al, dijital olarak sakla ve eğlenceye katıl.
                </p>

                <div class="hero-actions">
                    <a href="/Event/EventList"
                       class="ticketora-btn ticketora-btn-primary">

                        Etkinlikleri Keşfet

                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="18"
                             height="18"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2.2"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M5 12h14"></path>
                            <path d="m13 6 6 6-6 6"></path>
                        </svg>
                    </a>

                    <a href="/Account/Register"
                       class="ticketora-btn ticketora-btn-light">

                        Ücretsiz Üye Ol
                    </a>
                </div>

                <div class="hero-trust">
                    <div class="hero-trust-item">
                        <span class="hero-trust-icon">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="16"
                                 height="16"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">
                                <path d="M20 6 9 17l-5-5"></path>
                            </svg>
                        </span>
                        Güvenli ödeme
                    </div>

                    <div class="hero-trust-item">
                        <span class="hero-trust-icon">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="16"
                                 height="16"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">
                                <rect width="18" height="14" x="3" y="5" rx="2"></rect>
                                <path d="M7 15h.01"></path>
                                <path d="M11 15h2"></path>
                            </svg>
                        </span>
                        Anında dijital bilet
                    </div>

                    <div class="hero-trust-item">
                        <span class="hero-trust-icon">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="16"
                                 height="16"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2">
                                <path d="M12 2a10 10 0 1 0 10 10"></path>
                                <path d="M12 6v6l4 2"></path>
                            </svg>
                        </span>
                        7/24 hızlı erişim
                    </div>
                </div>
            </div>

            <div class="hero-ticket-wrapper">
                <div class="hero-ticket">

                    <div class="hero-ticket-image">
                        <span class="ticket-live-badge">
                            <span class="hero-eyebrow-dot"></span>
                            Canlı Konser
                        </span>
                    </div>

                    <div class="hero-ticket-body">
                        <div class="hero-ticket-category">
                            Ticketora Özel
                        </div>

                        <h2 class="hero-ticket-title">
                            İstanbul Müzik Gecesi
                        </h2>

                        <div class="hero-ticket-info">
                            <div class="ticket-info-item">
                                <small>Tarih</small>
                                <strong>24 Ağustos 2026</strong>
                            </div>

                            <div class="ticket-info-item">
                                <small>Saat</small>
                                <strong>21:00</strong>
                            </div>

                            <div class="ticket-info-item">
                                <small>Mekân</small>
                                <strong>Festival Park</strong>
                            </div>

                            <div class="ticket-info-item">
                                <small>Konum</small>
                                <strong>İstanbul</strong>
                            </div>
                        </div>

                        <div class="hero-ticket-bottom">
                            <div class="ticket-price">
                                <small>Başlangıç fiyatı</small>
                                <strong>₺750</strong>
                            </div>

                            <div class="ticket-qr" aria-label="Dijital bilet QR kodu">
                                @for (var i = 0; i < 25; i++)
                                {
                                    <span></span>
                                }
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </section>

    <!-- STATISTICS -->
    <div class="container stats-wrapper">
        <section class="ticketora-stats">

            <div class="stat-card">
